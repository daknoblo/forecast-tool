<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}} · Forecast Tool</title>
<meta name="description" content="{{.Lead}}">
<link rel="stylesheet" href="{{.Root}}assets/site.css">
</head>
<body>
<header class="topbar">
  <a class="brand" href="{{.Root}}index.html">Forecast&nbsp;Tool</a>
  <nav>
    {{range .Nav}}<a href="{{if not .External}}{{$.Root}}{{end}}{{.Href}}"{{if .External}} target="_blank" rel="noopener noreferrer"{{end}}{{if eq .Href $.Active}} class="active"{{end}}>{{.Label}}</a>{{end}}
  </nav>
</header>

{{if .Hero}}
<section class="hero">
  <h1 id="{{.HeadingID}}">Forecast Tool</h1>
  <p>{{.Lead}}</p>
  <p class="hero-actions">
    <a class="btn primary" href="demo/index.html">Open demo</a>
    <a class="btn" href="screenshots.html">Screenshots</a>
    <a class="btn" href="{{.RepoURL}}" target="_blank" rel="noopener noreferrer">Source code</a>
  </p>
  <p class="hero-note">A static snapshot of the real application with generated sample data: browse pages, without saving.</p>
</section>
{{end}}

<main>
{{if not .Hero}}<h1{{if .HeadingID}} id="{{.HeadingID}}"{{end}}>{{.Title}}</h1>{{if .Lead}}<p class="lead">{{.Lead}}</p>{{end}}{{end}}

{{if eq .Active "screenshots.html"}}
<div class="shots">
  {{range .Shots}}
  <figure id="{{.File}}">
    <a href="screenshots/{{.File}}"><img src="screenshots/{{.File}}" alt="{{.Title}}" loading="lazy"></a>
    <figcaption><strong>{{.Title}}</strong> {{.Description}}</figcaption>
  </figure>
  {{end}}
</div>
<h2 id="demo">Browse the demo</h2>
<p>Every captured view is also available as a static page with the same sample data:</p>
<p class="chips">
  {{range .DemoPages}}{{if .Title}}<a class="chip" href="demo/{{.File}}">{{.Title}}</a>{{end}}{{end}}
</p>
{{else}}
{{.Content}}
{{end}}
</main>

<footer>
  <span>Forecast Tool · generated on {{.GeneratedAt}}</span>
  <a href="{{.RepoURL}}" target="_blank" rel="noopener noreferrer">github.com/daknoblo/forecast-tool</a>
</footer>
</body>
</html>
